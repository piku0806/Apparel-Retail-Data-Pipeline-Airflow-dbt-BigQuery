# Copy to .env and fill in your own values before running `docker compose up`.

# Airflow (Linux hosts: set to `id -u` so mounted volumes aren't root-owned)
AIRFLOW_UID=50000

# GCP / BigQuery
GCP_PROJECT=your-gcp-project
BQ_DATASET_RAW=apparel_raw
BQ_LOCATION=US

# Path (inside the containers) to a service-account JSON key with BigQuery
# Data Editor + Job User roles. Mount your real key file to this path via the
# docker-compose volumes section (see docker-compose.yml) - never commit the
# key itself to version control.
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/keys/bq_service_account.json
